[sub_resource type="Shader" id="Shader_fjkcv"]
code = "shader_type canvas_item;

uniform float speed : hint_range(0.05, 5.0) = 0.1;

vec3 hsv2rgb(vec3 c) {
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

void fragment() {
    float hue = mod(TIME * speed, 1.0);
	float gradient = UV.y;
    COLOR = vec4(hsv2rgb(vec3(hue, 0.4, gradient)), 0.5);
}"

